# 复制为 config/local.env 并填写（local.env 不入 git）

# --- 项目路径 ---
SENSEHUB_ROOT=/path/to/SenseHub Agent
VENV_PATH=
PYTHON_PATH=/path/to/python
NODE_PATH=/path/to/node

# --- 数据与模型 ---
MODELS_ROOT=/path/to/SenseHub Agent/Models
DATA_ROOT=/path/to/SenseHub Agent/SenseHubData
SQLITE_PATH=/path/to/SenseHub Agent/SenseHubData/db/sensehub.db

# --- 硬件设备 ---
CAMERA_INDEX=0
MIC_DEVICE_NAME=
USE_CUDA=true
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_ENABLED=true

# --- 可选工具路径 ---
FFMPEG_PATH=
TESSERACT_PATH=
TESSDATA_PATH=
TLS_CERT_DIR=
CUDA_PATH=

# --- 浏览器 ---
EDGE_PATH=

# --- 硅基流动 SiliconFlow ---
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# --- 火山方舟 Volcengine Ark ---
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- 其他模型提供商（可选，在控制台 API Keys 填写亦可）---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1

# --- 服务 ---
API_HOST=127.0.0.1
API_PORT=8765
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me
LICENSE_TIER=lite

# --- 邮件（QQ 邮箱：smtp.qq.com / 465 / SSL）---
# 复制本文件为 config/local.env，在下方填写 SMTP 授权码（勿提交到 git）
EMAIL_DEV_EXPOSE_CODE=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=在此填写QQ邮箱SMTP授权码
SMTP_FROM=your-email@qq.com

# --- 以下 OAuth 配置已停用，可留空 ---
# 回调地址需在各平台登记为：
# http://127.0.0.1:8765/api/auth/oauth/github/callback
# http://127.0.0.1:8765/api/auth/oauth/qq/callback
# http://127.0.0.1:8765/api/auth/oauth/wechat/callback
OAUTH_FRONTEND_URL=http://127.0.0.1:5173
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
QQ_OAUTH_APP_ID=
QQ_OAUTH_APP_KEY=
WECHAT_OAUTH_APP_ID=
WECHAT_OAUTH_APP_SECRET=
